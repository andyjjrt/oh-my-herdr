{
  "_comment": [
    "oh-my-herdr default: Claude Code leads; workers are Claude Code or senpi on OpenCode Go.",
    "Copy to ~/.config/oh-my-herdr/config.json (global) or <project>/.omh/config.json (per project) and edit.",
    "profiles.<name>.agent picks a launch definition (assets/agents.json, or \"agents\" below); args go to that agent's CLI.",
    "family is used so a reviewer never shares a model family with the code it reviews.",
    "Model IDs come from senpi's model registry (Nov 2026) — check with `senpi --list-models opencode-go`."
  ],
  "lead": "claude-opus",
  "max_concurrent": 5,

  "quota": {
    "enabled": true,
    "threshold": 95,
    "cache_seconds": 120,
    "on_unknown": "allow",
    "providers": {
      "claude":      { "enabled": true },
      "opencode-go": { "enabled": true }
    }
  },

  "agents": {},

  "profiles": {
    "claude-opus":   { "agent": "claude", "family": "claude", "args": ["--model", "opus"] },
    "claude-sonnet": { "agent": "claude", "family": "claude", "args": ["--model", "sonnet", "--permission-mode", "acceptEdits"] },
    "claude-review": { "agent": "claude", "family": "claude", "args": ["--model", "opus", "--permission-mode", "plan"] },

    "go-deepseek":   { "agent": "senpi", "family": "deepseek", "args": ["--provider", "opencode-go", "--model", "deepseek-v4.1-flash", "--thinking", "max"] },
    "go-fast":       { "agent": "senpi", "family": "deepseek", "args": ["--provider", "opencode-go", "--model", "deepseek-v4.1-flash", "--thinking", "low"] }
  },

  "categories": {
    "oracle":             ["claude-review", "go-deepseek"],
    "deep":               ["go-deepseek", "claude-sonnet"],
    "visual-engineering": ["claude-sonnet", "go-deepseek"],
    "explore":            ["go-fast", "go-deepseek"],
    "librarian":          ["go-fast", "go-deepseek"],
    "quick":              ["go-fast", "go-deepseek"],
    "writing":            ["go-deepseek", "claude-sonnet"],
    "reviewer":           ["claude-review", "go-deepseek"]
  }
}
